//@version=5
// NSS - Nifty Swing Signals: INDICATOR. Marks A/B/C long setups with entry / stop / target lines, a confluence score and alerts.
// Spec: trading-signal-system/STRATEGY_SPEC.md. Daily chart, NSE cash stocks, long-only. Paper trading until the backtest passes.
indicator("NSS Nifty Swing Signals", shorttitle="NSS", overlay=true, max_lines_count=500, max_labels_count=500)
// ===================== SHARED CORE (generated into both scripts by tools/build_pine.py; edit _core.pine.part only) =====================
// ---------- Inputs
grpG = "General"
capital    = input.float(50000, "Paper capital (INR)", minval=1000, step=1000, group=grpG)
riskPct    = input.float(1.0, "Risk per trade % at HIGH confidence (MED = half)", minval=0.1, step=0.25, group=grpG)
maxPosPct  = input.float(25, "Max position size % of capital", minval=1, maxval=100, group=grpG)
regSym     = input.symbol("NSE:NIFTY", "Regime index", group=grpG)
vixSym     = input.symbol("NSE:INDIAVIX", "Volatility index", group=grpG)
vixCap     = input.float(20, "VIX cap (above = no trade)", group=grpG)
macroDates = input.string("2026-10-12,2027-02-01", "Macro veto dates YYYY-MM-DD, comma separated (RBI, CPI, FOMC, Budget)", group=grpG)
vetoDays   = input.int(14, "Veto window, calendar days ahead", minval=1, group=grpG)
useEarn    = input.bool(true, "Veto when earnings fall inside the window", group=grpG)
grpS = "Strategies"
useA = input.bool(true, "A - Trend pullback to 20-EMA", group=grpS)
useB = input.bool(true, "B - Squeeze breakout with volume", group=grpS)
useC = input.bool(true, "C - Mean reversion at 50-EMA (short hold)", group=grpS)
minScore = input.int(6, "Minimum confluence score (6 = MED, 8 = HIGH only)", minval=0, maxval=10, group=grpS)

// ---------- Indicators (all on the closed daily bar)
ema10  = ta.ema(close, 10)
ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
atr    = ta.atr(14)
atr10  = ta.atr(10)
atr50  = ta.atr(50)
rsi14  = ta.rsi(close, 14)
rsi2   = ta.rsi(close, 2)
[diPlus, diMinus, adx] = ta.dmi(14, 14)
volSma = ta.sma(volume, 20)[1]            // prior 20 bars, excludes the signal bar
hh20   = ta.highest(high, 20)[1]           // prior 20-bar high, excludes the signal bar
ll20   = ta.lowest(low, 20)[1]
[bbMid, bbUp, bbLo] = ta.bb(close, 20, 2)
bbw    = (bbUp - bbLo) / bbMid
bbwLow = bbw <= ta.lowest(bbw, 60)
tick   = syminfo.mintick

// ---------- Regime (spec 3.1) and volatility cap
[nClose, nEma50, nEma50p] = request.security(regSym, "D", [close, ta.ema(close, 50), ta.ema(close, 50)[10]], lookahead=barmerge.lookahead_off)
regimeOn = nClose > nEma50 and nEma50 > nEma50p
vix      = request.security(vixSym, "D", close, lookahead=barmerge.lookahead_off)
vixOk    = na(vix) or vix <= vixCap
// Weekly agreement, non-repainting: last COMPLETED weekly bar
wkUp     = request.security(syminfo.tickerid, "W", close[1] > ta.ema(close, 20)[1], lookahead=barmerge.lookahead_on)

// ---------- News veto (spec 3.2): macro dates from input + earnings from TradingView data
var int[] macroTs = array.new_int()
if barstate.isfirst
    parts = str.split(macroDates, ",")
    if array.size(parts) > 0
        for i = 0 to array.size(parts) - 1
            ymd = str.split(str.trim(array.get(parts, i)), "-")
            if array.size(ymd) == 3
                y = str.tonumber(array.get(ymd, 0))
                m = str.tonumber(array.get(ymd, 1))
                d = str.tonumber(array.get(ymd, 2))
                if not na(y) and not na(m) and not na(d)
                    array.push(macroTs, timestamp("Asia/Kolkata", int(y), int(m), int(d), 0, 0))
f_macroVeto() =>
    v = false
    if array.size(macroTs) > 0
        for i = 0 to array.size(macroTs) - 1
            t = array.get(macroTs, i)
            if t >= time - 86400000 and t - time <= vetoDays * 86400000
                v := true
    v
earnVeto = useEarn and not na(earnings.future_time) and earnings.future_time >= time - 86400000 and earnings.future_time - time <= vetoDays * 86400000
newsVeto = f_macroVeto() or earnVeto
baseOk   = timeframe.isdaily and regimeOn and vixOk and not newsVeto

// ---------- Strategy A: trend pullback to the 20-EMA (spec 4A)
pullLow5  = ta.lowest(low, 5)
nearEma20 = ta.lowest(low - ema20, 5) <= 0.5 * atr
heldEma20 = ta.lowest(close - ema20, 5) >= -atr
revBar    = close > open and close >= low + 0.5 * (high - low)
setupA    = useA and baseOk and close > ema50 and ema50 > ema50[10] and adx >= 20 and nearEma20 and heldEma20 and rsi14 >= 40 and rsi14 <= 60 and revBar
entryA    = high + tick
slA       = pullLow5 - 0.25 * atr
distA     = (entryA - slA) / entryA
okA       = setupA and distA <= 0.04 and distA >= 0.01

// ---------- Strategy B: volatility-contraction breakout with volume (spec 4B)
squeeze   = atr10 < 0.8 * atr50 or bbwLow
setupB    = useB and baseOk and squeeze and close > hh20 and volume >= 1.5 * volSma and (close - hh20) < 1.5 * atr
entryB    = high + tick
slB       = math.max(low, hh20 - 0.5 * atr) - tick
distB     = (entryB - slB) / entryB
okB       = setupB and distB <= 0.05 and distB >= 0.01

// ---------- Strategy C: mean reversion at the 50-EMA in a long-term uptrend (spec 4C)
notFreefall = close >= low + 0.3 * (high - low) and close / close[3] - 1 > -0.08
setupC    = useC and baseOk and close > ema200 and rsi2 < 10 and close < ema20 and math.abs(close - ema50) <= atr and notFreefall
entryC    = close                                   // limit order at the signal close, fills next day if low <= limit
slC       = low - 0.5 * atr
distC     = (entryC - slC) / entryC
okC       = setupC and distC <= 0.035 and distC >= 0.005

// ---------- Conflict rule (spec 5): two strategies on the same bar = no trade
nSig = (okA ? 1 : 0) + (okB ? 1 : 0) + (okC ? 1 : 0)
sig  = nSig != 1 ? 0 : okA ? 1 : okB ? 2 : 3
sigEntry = sig == 1 ? entryA : sig == 2 ? entryB : sig == 3 ? entryC : na
sigSL    = sig == 1 ? slA    : sig == 2 ? slB    : sig == 3 ? slC    : na
sigR     = sigEntry - sigSL
sigT1    = sig == 1 ? sigEntry + 1.5 * sigR : sig == 2 ? sigEntry + 2.0 * sigR : sig == 3 ? ema10 : na   // C exits on close > EMA10; shown as reference
sigT2    = sig == 1 ? sigEntry + 3.0 * sigR : na                                                          // B trails after T1, C has no T2

// ---------- Confluence score (spec 3.4)
scoreTrend = (close > ema20 and ema20 > ema50 and adx > 25) ? 2 : (close > ema50 and adx >= 20) ? 1 : 0
f_mom(lo, hi) =>
    inBand = rsi14 >= lo and rsi14 <= hi
    d = rsi14 - rsi14[1]
    inBand and d > 1 ? 2 : inBand and math.abs(d) <= 1 ? 1 : 0
momA = f_mom(40, 60)
momB = f_mom(50, 75)
momC = f_mom(0, 40)
scoreMom = sig == 1 ? momA : sig == 2 ? momB : sig == 3 ? momC : 0
scoreVol = volume >= 1.5 * volSma ? 2 : volume >= volSma ? 1 : 0
f_sr(e) =>
    d = math.min(math.abs(e - ema20), math.abs(e - ema50), math.abs(e - hh20), math.abs(e - ll20))
    d <= atr ? 2 : d <= 2 * atr ? 1 : 0
srVal    = f_sr(nz(sigEntry, close))
scoreSR  = sig > 0 ? srVal : 0
scoreHTF = (wkUp and regimeOn) ? 2 : (wkUp or regimeOn) ? 1 : 0
score    = sig > 0 ? scoreTrend + scoreMom + scoreVol + scoreSR + scoreHTF : 0
confTxt  = score >= 8 ? "HIGH" : score >= 6 ? "MED" : "LOW"
riskUse  = score >= 8 ? riskPct : score >= 6 ? riskPct / 2 : 0.0

// ---------- Position size (spec 3.3)
qtyRisk  = sig > 0 and riskUse > 0 ? math.floor(capital * riskUse / 100 / sigR) : 0
qtyCap   = sig > 0 ? math.floor(capital * maxPosPct / 100 / sigEntry) : 0
qty      = math.max(0, math.min(qtyRisk, qtyCap))
fire     = sig > 0 and score >= minScore and qty >= 1
stratTxt = sig == 1 ? "A pullback" : sig == 2 ? "B breakout" : sig == 3 ? "C mean-rev" : "-"
// ===================== END SHARED CORE =====================

// ===================== INDICATOR OUTPUT =====================
plot(ema20, "EMA20", color=color.new(color.orange, 0), linewidth=1)
plot(ema50, "EMA50", color=color.new(color.blue, 0), linewidth=1)
plot(ema200, "EMA200", color=color.new(color.gray, 30), linewidth=1)
bgcolor(timeframe.isdaily and not regimeOn ? color.new(color.red, 92) : na, title="Regime OFF shade")
bgcolor(timeframe.isdaily and newsVeto ? color.new(color.yellow, 88) : na, title="News veto shade")

// Signal markers and levels, drawn only on confirmed bars (no live-bar repaint)
if fire and barstate.isconfirmed
    x2 = bar_index + 10
    line.new(bar_index, sigEntry, x2, sigEntry, color=color.green, width=2)
    line.new(bar_index, sigSL, x2, sigSL, color=color.red, width=2)
    if not na(sigT1)
        line.new(bar_index, sigT1, x2, sigT1, color=color.teal, style=line.style_dashed)
    if not na(sigT2)
        line.new(bar_index, sigT2, x2, sigT2, color=color.teal, style=line.style_dotted)
    txt = stratTxt + "  " + confTxt + " " + str.tostring(score) + "/10\nEntry " + str.tostring(sigEntry, format.mintick) + "  SL " + str.tostring(sigSL, format.mintick) + "\nT1 " + str.tostring(sigT1, format.mintick) + (na(sigT2) ? "" : "  T2 " + str.tostring(sigT2, format.mintick)) + "\nQty " + str.tostring(qty) + "  risk INR " + str.tostring(math.round(qty * sigR))
    label.new(bar_index, low - atr, txt, style=label.style_label_up, color=color.new(color.green, 20), textcolor=color.white, size=size.small)
plotshape(sig > 0 and not fire and barstate.isconfirmed, "Setup but LOW / unsized", shape.circle, location.belowbar, color=color.new(color.gray, 40), size=size.tiny)

// Status table
var table tb = table.new(position.top_right, 2, 11, border_width=1)
f_row(r, k, v, c) =>
    table.cell(tb, 0, r, k, text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.small)
    table.cell(tb, 1, r, v, text_color=color.white, bgcolor=c, text_size=size.small)
if barstate.islast
    ok = color.new(color.green, 30)
    bad = color.new(color.red, 30)
    neu = color.new(color.gray, 30)
    f_row(0, "Chart TF", timeframe.isdaily ? "Daily OK" : "NOT DAILY - switch to 1D", timeframe.isdaily ? ok : bad)
    f_row(1, "Regime (Nifty>EMA50 rising)", regimeOn ? "ON" : "OFF - no new longs", regimeOn ? ok : bad)
    f_row(2, "India VIX", na(vix) ? "n/a" : str.tostring(vix, "#.#") + (vixOk ? " ok" : " > cap"), vixOk ? ok : bad)
    f_row(3, "News veto (14d)", newsVeto ? (earnVeto ? "EARNINGS" : "MACRO date") : "clear", newsVeto ? bad : ok)
    f_row(4, "Stock ADX / RSI14 / RSI2", str.tostring(adx, "#") + " / " + str.tostring(rsi14, "#") + " / " + str.tostring(rsi2, "#"), neu)
    f_row(5, "Weekly > EMA20", wkUp ? "yes" : "no", wkUp ? ok : neu)
    f_row(6, "Signal this bar", sig > 0 ? stratTxt : "none", sig > 0 ? ok : neu)
    f_row(7, "Score T/M/V/SR/HTF", sig > 0 ? str.tostring(scoreTrend) + "/" + str.tostring(scoreMom) + "/" + str.tostring(scoreVol) + "/" + str.tostring(scoreSR) + "/" + str.tostring(scoreHTF) + " = " + str.tostring(score) + " " + confTxt : "-", sig > 0 ? (score >= 8 ? ok : score >= 6 ? color.new(color.orange, 30) : bad) : neu)
    f_row(8, "Entry / SL", sig > 0 ? str.tostring(sigEntry, format.mintick) + " / " + str.tostring(sigSL, format.mintick) : "-", neu)
    f_row(9, "T1 / T2", sig > 0 ? str.tostring(sigT1, format.mintick) + " / " + (na(sigT2) ? "trail" : str.tostring(sigT2, format.mintick)) : "-", neu)
    f_row(10, "Qty @ INR " + str.tostring(capital, "#"), fire ? str.tostring(qty) + " sh, risk INR " + str.tostring(math.round(qty * sigR)) : (sig > 0 ? "0 (LOW or unsized) = NO TRADE" : "NO TRADE"), fire ? ok : neu)

// Alerts. Static conditions (pick in the alert dialog) plus one dynamic alert() with the full signal text.
alertcondition(fire and sig == 1, "NSS A pullback long", "NSS A pullback setup on {{ticker}}")
alertcondition(fire and sig == 2, "NSS B breakout long", "NSS B breakout setup on {{ticker}}")
alertcondition(fire and sig == 3, "NSS C mean-reversion long", "NSS C mean-reversion setup on {{ticker}}")
alertcondition(fire, "NSS any long setup", "NSS setup on {{ticker}}")
if fire and barstate.isconfirmed
    alert(syminfo.ticker + " | LONG | " + confTxt + " " + str.tostring(score) + "/10 | " + stratTxt + " | Entry " + str.tostring(sigEntry, format.mintick) + " SL " + str.tostring(sigSL, format.mintick) + " T1 " + str.tostring(sigT1, format.mintick) + (na(sigT2) ? "" : " T2 " + str.tostring(sigT2, format.mintick)) + " | Qty " + str.tostring(qty), alert.freq_once_per_bar_close)
